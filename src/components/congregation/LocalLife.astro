---
import type { Congregation } from "../../data/congregations";
import FeatureCard from "../FeatureCard.astro";
import { beliefs, worship } from "../../data/congregation-content";
const { c } = Astro.props as { c: Congregation };
const studies = c.gatherings.filter(g=>g.kind==='study');
---
<section class="cf-section" id="our-faith"><div class="container"><div class="cf-heading"><span class="eyebrow">New Testament Christianity</span><h2>Rooted in Scripture. United in Christ.</h2><p>We seek to follow Jesus and the pattern of faith and worship taught in the New Testament.</p></div><div class="cf-three cf-features">{beliefs.map(item=><FeatureCard {...item}/>)}</div><div class="cf-centered"><a class="cf-text-link" href="/resources/church-history/">Explore church history and restoration →</a></div></div></section>
<section class="cf-section cf-tint" id="worship"><div class="container"><div class="cf-heading"><span class="eyebrow">Your first visit</span><h2>Christian worship in {c.name}.</h2><p>Learn about five aspects of New Testament worship. You are welcome to observe, listen and ask questions.</p></div><div class="cf-five cf-features">{worship.map(item=><FeatureCard {...item}/>)}</div><p class="cf-centered cf-muted">{c.language ? `Worship languages at ${c.name}: ${c.language}.` : `Contact the congregation in ${c.name} to confirm worship languages.`} Confirm local arrangements before travelling.</p><div class="cf-centered"><a class="cf-btn" href="#visit">See worship location and timings →</a></div></div></section>
<section class="cf-section" id="bible-study"><div class="container cf-split cf-study"><div><span class="eyebrow">Beyond worship</span><h2>Bible study in {c.name}.</h2><p class="cf-lead">Bible study is an opportunity to open Scripture together, ask honest questions and learn to follow Christ in everyday life.</p><div class="cf-schedules">{studies.map(s=><article><span class="cf-overline">{c.detailsStatus === "legacy" ? "Earlier study listing · unverified" : "Weekly Bible study"}</span><h3>{s.name}</h3><strong>{s.day || 'Day to confirm'} · {s.time}</strong><p>Contact the congregation to confirm the meeting and study language.</p></article>)}{!studies.length && <p>Contact the congregation to enquire about weekly Bible study arrangements.</p>}</div><div class="cf-actions"><a class="cf-btn" href="#connect">Enquire about a Bible study →</a><a class="cf-btn secondary" href="#visit">Meeting location</a></div></div><figure class="cf-editorial"><img src="/images/home/bibleStudy.jpg" alt="An open Bible and study pen" loading="lazy"/><figcaption>Illustrative Scripture study photograph · <a href="/image-credits/">Credits</a></figcaption></figure></div></section>
<section class="cf-section cf-tint" id="preacher"><div class="container cf-preacher"><div class="cf-preacher-copy"><span class="eyebrow">
  {c.preacher
    ? "Meet our preacher"
    : c.contactName
      ? "Meet your congregation contact"
      : "Local congregation"}
</span>

<h2>
  {c.preacher || c.contactName || "Growing together in Christ."}
</h2>{c.detailsStatus === "legacy" && c.preacher && <p class="cf-muted">Preacher name from an earlier listing; confirmation pending.</p>}<p class="cf-lead">Church of Christ · {c.name}</p><p>Questions about Jesus, the Bible, baptism or visiting for the first time? Reach out to discuss your questions and arrange a conversation or Bible study.</p>{c.contacts[0]?.phone ? <a class="cf-btn" href={`tel:+91${c.contacts[0].phone}`}>{c.preacher ? "Speak with our preacher →" : "Speak with our congregation contact →"}</a> : c.email ? <a class="cf-btn" href={`mailto:${c.email}`}>Email the congregation →</a> : <p class="cf-muted">Local contact details are being confirmed.</p>}</div>{c.portrait && <img class:list={["cf-portrait", c.portraitSquare && "cf-portrait-square"]} src={c.portrait} alt={c.preacher} loading="lazy"/>}<aside class="cf-preacher-verse"><span class="cf-overline">Teaching God's Word</span><blockquote>“Preach the word; be instant in season, out of season.”</blockquote><cite>2 Timothy 4:2 · KJV excerpt</cite></aside></div></section>
{c.photos.length > 0 && (
  <section class="cf-section cf-community" id="gallery">
    <div class="container">

      <div class="cf-heading">
        <span class="eyebrow">Life together</span>
        <h2>Our congregation.</h2>
        <p>
          Discover the joy of Christian fellowship,
          worship and growing together in God's Word.
        </p>
      </div>

      <div class="cf-community-feature">

        <figure class="cf-community-photo">
          <img
            src={c.photos[0]}
            alt={`Members of the Church of Christ in ${c.name}`}
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            {c.name} Church of Christ
          </figcaption>
        </figure>

        <div class="cf-community-copy">

          <span class="eyebrow">One family in Christ</span>
          <h3>Growing together in faith.</h3>

          <p>
            Christian fellowship is an opportunity
            to encourage one another, study Scripture
            and grow as disciples of Jesus Christ.
          </p>

          <blockquote>
            “And let us consider one another to provoke
            unto love and to good works.”
            <cite>Hebrews 10:24 · KJV</cite>
          </blockquote>

          <a class="cf-btn" href="#visit">
            Come and worship with us →
          </a>

        </div>

      </div>

      {c.photos.length > 1 && (
        <div class="cf-community-more">
          {c.photos.slice(1).map((photo, i) => (
            <figure>
              <img
                src={photo}
                alt={`${c.name} congregation photograph ${i + 2}`}
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))}
        </div>
      )}

    </div>
  </section>
)}
<section class="cf-section" id="resources"><div class="container"><div class="cf-heading"><span class="eyebrow">Continue learning</span><h2>Explore Scripture at your own pace.</h2><p>Start with these resources as you prepare to meet the congregation.</p></div><div class="cf-three cf-resources"><a href="#discover-jesus"><img src="/images/home/scriptures.jpg" alt="Scripture study illustration" loading="lazy"/><div><h3>Discover Jesus</h3><p>Explore the Gospel and the life of Christ.</p><strong>Start reading →</strong></div></a><a href="#worship"><img src="/images/home/communion.jpg" alt="Bible and communion elements" loading="lazy"/><div><h3>Remember Christ</h3><p>Explore the Lord’s Supper and the Biblical foundations of worship.</p><strong>Learn about worship →</strong></div></a><a href="/resources/bible-studies/">
  <img
    src="/images/home/christianLiving.jpg"
    alt="An open Bible for personal Scripture study"
    loading="lazy"
  />
  <div>
    <h3>Grow in God's Word</h3>
    <p>
      Explore guided Bible study lessons and your questions
      through a personal study of Scripture.
    </p>
    <strong>Explore Bible studies →</strong>
  </div>
</a></div></div></section>
