---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { availableCongregations, totalCongregations } from "../../data/congregations";
const { initialRegion = "all" } = Astro.props as { initialRegion?: string };
const rows = [...availableCongregations].sort((a,b)=>a.name.localeCompare(b.name));
const regionKey = (region:string) => region === "Mumbai" ? "mumbai" : region === "Navi Mumbai" ? "navi-mumbai" : "mmr";
const languages = [...new Set(rows.flatMap(c=>c.language.split(/\s+and\s+|,\s*/i).filter(Boolean)))].sort();
---
<BaseLayout title="Find a Church of Christ Near You" description="Discover local congregations, worship and Bible study across Mumbai, Navi Mumbai and the surrounding region." noindex={true}>
  <div class="cd" data-directory data-initial-region={initialRegion}>
    <section class="cd-hero"><div class="container">
      <nav aria-label="Breadcrumb"><a href="/">Home</a> / Congregations</nav>
      <span class="eyebrow">One faith · Local congregations</span>
      <h1>Find a congregation.<br/><em>Grow in Christ.</em></h1>
      <p>Explore Churches of Christ across Mumbai, Navi Mumbai and the wider region. Find worship, weekly Bible studies and a place to learn about Jesus.</p>
      <div class="cd-stats"><div><strong>{totalCongregations}</strong><span>Congregations reported</span></div><div><strong>{rows.length}</strong><span>Profiles available here</span></div></div>
      <a class="button button-primary" href="#finder">Find your local congregation →</a>
    </div></section>
    <section class="cd-body" id="finder"><div class="container">
      <div class="cd-heading"><span class="eyebrow">Explore congregations</span><h2>Find your local Church of Christ.</h2><p>Filter by region, worship language or Bible study availability.</p></div>
      <div class="cd-filters">
        <div class="cd-tabs" aria-label="Filter by region">{[["all","All Congregations"],["mumbai","Mumbai"],["navi-mumbai","Navi Mumbai"],["mmr","Wider Mumbai Region"]].map(([key,label])=><button type="button" data-region-filter={key} aria-pressed={key===initialRegion}>{label}</button>)}</div>
        <div class="cd-inputs"><label>Search location or preacher<input type="search" data-search placeholder="e.g. Dharavi, Vashi, Goregaon..." /></label><label>Worship language<select data-language><option value="all">All languages</option>{languages.map(l=><option value={l}>{l}</option>)}</select></label><label class="cd-check"><input type="checkbox" data-study/> Weekly study schedule supplied</label></div>
      </div>
      <p class="cd-count" role="status" data-count>{rows.length} congregation profiles</p>
      <div class="cd-grid">{rows.map(c=><article class="cd-card" data-card data-region={regionKey(c.region)} data-terms={`${c.name} ${c.region} ${c.preacher} ${c.address} ${c.language}`.toLowerCase()} data-languages={c.language.split(/\s+and\s+|,\s*/i).filter(Boolean).join('|')} data-study-available={String(c.detailsStatus!=="legacy" && c.gatherings.some(g=>g.kind==='study' && g.day && g.time))}>
        <div class="cd-art">{c.photos[0] ? <img src={c.photos[0]} alt={`${c.name} congregation`} loading="lazy"/> : <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M40 70S17 46 17 31a23 23 0 1 1 46 0C63 46 40 70 40 70Z"/><path d="M40 19v24M31 27h18"/></svg>}<span>{c.region}</span></div>
        <div class="cd-card-body"><h3>{c.name}</h3>{c.detailsStatus==='legacy' ? <p class="cd-note">Earlier meeting details · unverified</p> : c.detailsStatus==='pending' ? <p class="cd-note">Local details being collected</p> : !c.approved ? <p class="cd-note">Local preview · approval pending</p> : null}
        {c.language && <p class="cd-language">{c.language} worship</p>}
        {c.gatherings.length ? <div class="cd-times">{c.gatherings.map(g=><div><strong>{g.name}</strong><span>{g.day || 'Day to confirm'} · {g.time}</span></div>)}</div> : <p>Worship and Bible study timings to be confirmed.</p>}
        <a class="cd-action" href={`/congregations/${c.slug}/`}>Explore congregation <span>→</span></a></div>
      </article>)}</div>
      <p data-empty hidden class="cd-empty">No matching profiles yet. Try a different filter or <button type="button" data-reset>show all congregations</button>.</p>
      <p class="cd-footnote">More congregation profiles are being prepared. Confirm local meeting arrangements before travelling.</p>
    </div></section>
    <section class="cd-invite"><div class="container"><span class="eyebrow">Begin where you are</span><h2>Come and discover Christ.</h2><p>Choose a congregation to explore Scripture, worship and Bible study at your own pace.</p><a class="button button-outline" href="#finder">Explore the directory ↑</a></div></section>
  </div>
</BaseLayout>
<script>
  const el=document.querySelector<HTMLElement>('[data-directory]');
  if(el){
    const tabs=Array.from(el.querySelectorAll<HTMLButtonElement>('[data-region-filter]'));
    const cards=Array.from(el.querySelectorAll<HTMLElement>('[data-card]'));
    const search=el.querySelector<HTMLInputElement>('[data-search]')!;
    const language=el.querySelector<HTMLSelectElement>('[data-language]')!;
    const study=el.querySelector<HTMLInputElement>('[data-study]')!;
    const params=new URLSearchParams(location.search);
    let region=params.get('region') || el.dataset.initialRegion || 'all';
    if(!tabs.some(b=>b.dataset.regionFilter===region)) region='all';
    search.value=params.get('q') || '';
    function update(sync=false){
      const q=search.value.trim().toLowerCase(); let visible=0;
      tabs.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.regionFilter===region)));
      cards.forEach(card=>{
        const ok=(region==='all'||card.dataset.region===region)&&(!q||card.dataset.terms?.includes(q))&&(language.value==='all'||card.dataset.languages?.split('|').includes(language.value))&&(!study.checked||card.dataset.studyAvailable==='true');
        card.hidden=!ok; if(ok) visible++;
      });
      el!.querySelector('[data-count]')!.textContent=`${visible} of ${cards.length} congregation profiles`;
      el!.querySelector<HTMLElement>('[data-empty]')!.hidden=visible!==0;
      if(sync){const url=new URL('/congregations/',location.origin); if(region!=='all')url.searchParams.set('region',region); if(search.value.trim())url.searchParams.set('q',search.value.trim()); history.replaceState(null,'',url.pathname+url.search+location.hash);}
    }
    tabs.forEach(b=>b.addEventListener('click',()=>{region=b.dataset.regionFilter || 'all';update(true);}));
    search.addEventListener('input',()=>update(true));language.addEventListener('change',()=>update());study.addEventListener('change',()=>update());
    el.querySelector('[data-reset]')?.addEventListener('click',()=>{region='all';search.value='';language.value='all';study.checked=false;update(true);});
    update();
  }
</script>
<style>
.cd [hidden]{display:none!important}.cd-hero{padding:35px 0 80px;background:linear-gradient(100deg,#112239f5,#182d49d9),url('/images/home/mumbai.jpg') center/cover;color:white}.cd-hero nav{font-size:14px;color:#d2dce8;margin-bottom:55px}.cd-hero .eyebrow{color:#d6bf91}.cd-hero h1{color:white;margin:20px 0;max-width:900px}.cd-hero h1 em{color:#d6bf91;font-weight:400}.cd-hero p{max-width:680px;font-size:20px;color:#d2dce8}.cd-stats{display:flex;gap:42px;flex-wrap:wrap;margin:30px 0}.cd-stats div{display:grid}.cd-stats strong{font:500 44px/1.2 var(--font-heading);color:#d6bf91}.cd-stats span{font-size:15px}.cd-hero .button{background:var(--ivory);color:var(--forest)}.cd-body{padding:clamp(55px,7vw,105px) 0;background:var(--paper)}.cd-heading h2,.cd-invite h2{margin:18px 0}.cd-heading p,.cd-invite p{color:var(--muted);font-size:18px}.cd-filters{padding:24px;border:1px solid var(--sand);background:var(--ivory);border-radius:12px;margin:30px 0 16px}.cd-tabs{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:24px}.cd-tabs button{border:1px solid var(--sand);border-radius:5px;padding:10px 16px;color:var(--forest);background:white;font-weight:600}.cd-tabs button[aria-pressed=true]{color:white;background:var(--forest);border-color:var(--forest)}.cd-inputs{display:grid;grid-template-columns:1.5fr 1fr auto;align-items:end;gap:16px}.cd-inputs label{display:grid;gap:7px;font-size:14px;font-weight:600;color:var(--forest)}.cd-inputs input[type=search],.cd-inputs select{width:100%;min-width:0;padding:12px;border:1px solid var(--sand);border-radius:5px;background:white;color:var(--forest)}.cd-inputs .cd-check{display:flex;align-items:center;min-height:50px;gap:9px}.cd-count,.cd-footnote,.cd-note{color:var(--muted);font-size:14px}.cd-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;align-items:stretch}.cd-card{display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--sand);border-radius:12px;background:var(--ivory);transition:transform .3s,box-shadow .3s,border-color .3s}.cd-art{position:relative;display:grid;place-items:center;min-height:135px;background:radial-gradient(ellipse at 75% 10%,#36577b,#112239);color:#d6bf91}.cd-art svg{width:62px;margin-bottom:16px}.cd-art img{width:100%;height:175px;object-fit:cover}.cd-art span{position:absolute;bottom:8px;left:15px;font-size:11px;text-transform:uppercase;letter-spacing:.12em;background:#112239;color:#d6bf91;padding:4px 8px;border-radius:4px}.cd-card-body{display:flex;flex:1;flex-direction:column;padding:24px}.cd-card h3{margin:0 0 12px;font-size:29px}.cd-language{font-weight:600;color:var(--forest);font-size:15px}.cd-times{margin-bottom:18px}.cd-times div{display:grid;gap:4px;border-top:1px solid var(--sand);padding:11px 0;font-size:14px}.cd-times span{color:var(--muted)}.cd-action{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:auto;border-top:1px solid var(--sand);padding-top:16px;font-weight:700;color:var(--forest)}.cd-footnote{margin-top:24px}.cd-empty{padding:24px;background:var(--ivory);border:1px solid var(--sand);border-radius:8px}.cd-empty button{border:0;background:none;color:var(--forest);font-weight:600;text-decoration:underline}.cd-invite{text-align:center;padding:70px 0;background:#eee9df}.cd-invite p{max-width:700px;margin-inline:auto}@media(hover:hover) and (pointer:fine){.cd-card:hover{transform:translateY(-5px);border-color:var(--gold);box-shadow:var(--shadow-soft)}.cd-tabs button:hover{border-color:var(--gold)}}@media(max-width:960px){.cd-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.cd-inputs{grid-template-columns:1fr 1fr}.cd-check{grid-column:1/-1}}@media(max-width:600px){.cd-grid,.cd-inputs{grid-template-columns:1fr}.cd-hero{padding-bottom:55px}.cd-hero nav{margin-bottom:35px}.cd-filters{padding:16px}.cd-tabs button{font-size:14px;padding:9px 11px}.cd-card-body{padding:20px}}
</style>
