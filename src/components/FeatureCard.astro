---
interface Props {
  number: string;
  title: string;
  description: string;
  scripture: string;
  detail: string;
}

const {
  number,
  title,
  description,
  scripture,
  detail
} = Astro.props;
---

<article class="feature-card">
  <span class="feature-number">{number}</span>

  <h3>{title}</h3>

  <p>{description}</p>

  <details>
    <summary>
      <span>{scripture}</span>
      <span class="feature-plus" aria-hidden="true">+</span>
    </summary>

    <div class="feature-detail">
      {detail}
    </div>
  </details>
</article>

<style>
  .feature-card {
    position: relative;
    min-width: 0;
    padding: clamp(24px, 3vw, 36px);
    border: 1px solid var(--sand);
    border-radius: var(--radius-medium);
    background: var(--paper);
    transition:
      transform .4s var(--ease),
      box-shadow .4s var(--ease),
      border-color .4s var(--ease);
  }

  .feature-number {
    display: block;
    margin-bottom: 34px;
    color: var(--gold-dark);
    font-size: 12px;
    letter-spacing: .15em;
  }

  h3 {
    margin-bottom: 18px;
  }

  p {
    color: var(--muted);
    font-size: 15px;
  }

  details {
    margin-top: 24px;
    border-top: 1px solid var(--sand);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 18px;
    cursor: pointer;
    list-style: none;
    color: var(--forest);
    font-size: 13px;
    font-weight: 600;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .feature-plus {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border: 1px solid var(--sand);
    border-radius: 50%;
    transition: transform .3s var(--ease);
  }

  details[open] .feature-plus {
    transform: rotate(45deg);
  }

  .feature-detail {
    padding-top: 14px;
    color: var(--muted);
    font-size: 14px;
  }

  @media (hover: hover) and (pointer: fine) {
    .feature-card:hover {
      transform: translateY(-5px);
      border-color: var(--gold);
      box-shadow: var(--shadow-hover);
    }
  }
</style>

<script>
  const hover = window.matchMedia(
    "(hover: hover) and (pointer: fine)"
  );

  document.querySelectorAll<HTMLElement>(".feature-card")
    .forEach((card) => {
      const details = card.querySelector("details");

      if (!details) return;

      let openedByHover = false;

      card.addEventListener("pointerenter", () => {
        if (hover.matches && !details.open) {
          details.open = true;
          openedByHover = true;
        }
      });

      card.addEventListener("pointerleave", () => {
        if (!openedByHover) return;
        if (card.contains(document.activeElement)) return;

        details.open = false;
        openedByHover = false;
      });

      card.addEventListener("focusout", (event) => {
        const next = event.relatedTarget;

        if (openedByHover &&
            !(next instanceof Node && card.contains(next)) &&
            !card.matches(":hover")) {
          details.open = false;
          openedByHover = false;
        }
      });

      details.querySelector("summary")
        ?.addEventListener("click", () => {
          openedByHover = false;
        });
    });
</script>
