---
import { congregations } from "../../data/congregations";

const { mode } = Astro.props as {
  mode: "worship" | "study"
};

const worship = mode === "worship";

const entries = congregations
  .filter(c => c.approved && !c.detailsStatus)
  .flatMap(c => c.gatherings
    .filter(g => g.kind === mode && g.time)
    .map(g => ({ c,g })))
  .sort((a,b) =>
    Number(Boolean(b.g.day)) - Number(Boolean(a.g.day))
    || a.c.name.localeCompare(b.c.name));
---

<section class="ls-section" id="local-schedules">
  <div class="container">
    <span class="eyebrow">
      {worship ? "Local worship information" : "Study Scripture together"}
    </span>

    <h2>
      {worship
        ? "Church worship timings in Mumbai and Navi Mumbai."
        : "Find a Bible study near you."}
    </h2>

    <p class="ls-intro">
      {worship
        ? "Find published worship times below. Where the meeting day is not confirmed, please contact the congregation before travelling."
        : "Enquire about personal and group Bible studies with a local congregation. Published schedules will appear here as they become available."}
    </p>

    {entries.length > 0 ? (
      <div class="ls-grid">
        {entries.map(({c,g})=>(
          <article class="ls-card" data-local-schedule={c.slug}>
            <span class="eyebrow">{c.region}</span>
            <h3>Church of Christ · {c.name}</h3>
            <div class="ls-time">
              <strong>{g.day || "Meeting day to confirm"}</strong>
              <span>{g.time}</span>
            </div>
            {c.address && <p>{c.address}</p>}
            {c.language && <p>Language: {c.language}</p>}
            <a href={`/congregations/${c.slug}/#${worship?"visit":"bible-study"}`}>
              {worship?"View meeting location and directions":"View Bible study information"} →
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="ls-empty">
        <h3>Enquire about local study arrangements.</h3>
        <p>
          No weekly Bible study timetable has been approved
          for publication yet. Contact a congregation directly
          to ask about available days, times and languages.
        </p>
        <a href="#local-contacts">Contact a congregation →</a>
      </div>
    )}

    <div class="ls-links">
      <a href="/congregations/">Find all local congregations →</a>
      {worship
        ? <a href="/request-a-bible-study/">Request a Bible study →</a>
        : <a href="/resources/bible-studies/">Read Bible study lessons →</a>}
    </div>
  </div>
</section>

<style>
  .ls-section{
    padding:clamp(48px,6vw,85px) 0;
    background:#f3eee5;
  }
  .ls-section h2{
    margin:18px 0;
    font-size:clamp(30px,4vw,48px);
  }
  .ls-intro{
    max-width:760px;
    font-size:18px;
    line-height:1.8;
    color:#5d6370;
  }
  .ls-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:20px;
    margin-top:28px;
  }
  .ls-card,.ls-empty{
    display:flex;
    flex-direction:column;
    padding:clamp(22px,3vw,32px);
    border:1px solid #ddd4c4;
    border-radius:12px;
    background:#fffdf8;
    transition:transform .25s,border-color .25s;
  }
  .ls-card h3,.ls-empty h3{
    margin:16px 0;
    font-size:28px;
  }
  .ls-time{
    display:grid;
    gap:6px;
    padding:16px;
    background:#182d49;
    color:white;
    border-radius:6px;
  }
  .ls-time strong{color:#d6bf91}
  .ls-time span{font-size:23px;font-weight:600}
  .ls-card p,.ls-empty p{
    line-height:1.75;
    color:#5d6370;
    margin:18px 0;
  }
  .ls-card a,.ls-empty a,.ls-links a{
    color:#182d49;
    text-decoration:underline;
    text-underline-offset:4px;
    font-weight:700;
  }
  .ls-card a{margin-top:auto;padding-top:12px}
  .ls-empty{margin-top:25px}
  .ls-links{display:flex;flex-wrap:wrap;gap:20px;margin-top:25px}
  @media(hover:hover) and (pointer:fine){
    .ls-card:hover{
      transform:translateY(-4px);
      border-color:#b49a66;
    }
  }
  @media(max-width:650px){
    .ls-grid{grid-template-columns:1fr}
  }
  @media(prefers-reduced-motion:reduce){
    .ls-card{transition:none}
  }
</style>
