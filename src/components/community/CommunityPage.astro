  .cm-closing p{color:#d2dce8}
  .cm-closing .cm-actions{justify-content:center}
  @media(hover:hover) and (pointer:fine){
    .cm-feature:hover,.cm-event-card:hover,.cm-btn:hover{
      transform:translateY(-4px);border-color:#b49a66;box-shadow:var(--shadow-soft)
    }
  }
  @media(max-width:900px){
    .cm-hero-grid,.cm-overview,.cm-faq-grid{grid-template-columns:1fr}
    .cm-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  @media(max-width:600px){
    .cm-grid{grid-template-columns:1fr}
    .cm-hero{padding-bottom:45px}
    .cm-hero p{font-size:17px}
    .cm-actions{flex-direction:column}
    .cm-timeline article{grid-template-columns:1fr;gap:10px;padding:20px}
    .cm-feature{padding:23px}
  }
  @media(prefers-reduced-motion:reduce){
    .cm-page *{transition:none!important;scroll-behavior:auto!important}
  }


