---
import ResourceArticle from "../../../components/resources/ResourceArticle.astro";
import { getResources } from "../../../data/biblical-resources";

export function getStaticPaths() {
  return getResources("sermons").map(resource => ({
    params: { lesson: resource.slug },
    props: { resource }
  }));
}

const { resource } = Astro.props;
---

<ResourceArticle resource={resource} />
