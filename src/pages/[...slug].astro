---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { navigation, connectionLinks } from "../data/navigation";
import { availableCongregations } from "../data/congregations";

export function getStaticPaths() {
  const pages = new Map();

  for (const group of navigation) {
    if (group.href === "/" || group.href === "/congregations/") continue;

    pages.set(group.href, {
      title: group.label,
      parent: "Home",
      parentHref: "/",
      links: group.children.filter(child => child.href !== group.href)
    });

    for (const child of group.children) {
      if (child.href === group.href ||
        child.href === "/resources/church-history/") continue;

      pages.set(child.href, {
        title: child.label,
        parent: group.label,
        parentHref: group.href,
        links: []
      });
    }
  }

  const built = new Set(availableCongregations.map(c => c.slug));
  for (const [slug, label] of [["vashi", "Vashi"], ["goregaon", "Goregaon"], ["nallasopara", "Nallasopara"], ["mira-road", "Mira Road"]]) {
    if (!built.has(slug)) pages.set(`/congregations/${slug}/`, {title:label,parent:"Congregations",parentHref:"/congregations/",links:[]});
  }
  for (const item of connectionLinks) {
    pages.set(item.href, {
      title: item.label,
      parent: "Home",
      parentHref: "/",
      links: []
    });
  }

  // Sprint 4H: dedicated resource libraries.
  pages.delete("/resources/");
  pages.delete("/resources/bible-studies/");
  pages.delete("/resources/sermons/");
  pages.delete("/resources/lords-supper/");
  pages.delete("/resources/questions-and-answers/");
  pages.delete("/resources/devotionals/");
  pages.delete("/about/");
  pages.delete("/about/what-we-believe/");
  pages.delete("/about/our-history/");
  pages.delete("/about/new-testament-christianity/");

  // Sprint 4K: dedicated Insights pages.
  pages.delete("/insights/");
  pages.delete("/insights/biblical-studies/");
  pages.delete("/insights/christian-living/");
  pages.delete("/insights/christian-apologetics/");
  pages.delete("/insights/new-testament-christianity/");
  pages.delete("/insights/spiritual-growth/");

  // Sprint 6A: dedicated community pages.
  pages.delete("/events/");
  pages.delete("/events/ignite/");
  pages.delete("/events/prerna/");
  pages.delete("/events/arise/");
  pages.delete("/events/archive/");
  pages.delete("/plan-your-visit/");
  pages.delete("/request-a-bible-study/");
  pages.delete("/prayer-requests/");
  pages.delete("/contact/");

  return Array.from(pages.entries()).map(([href, page]) => ({
    params: { slug: href.replace(/^\/|\/$/g, "") },
    props: { page }
  }));
}

const { page } = Astro.props;
const description = `${page.title} — Mumbai Church of Christ.`;

const events: Record<string, { text: string; url?: string }> = {
  "/events/ignite/": {
    text: "Ignite is a Christian gathering in Bangalore.",
    url: "https://www.blrchurchofchrist.in/#ignite"
  },
  "/events/prerna/": {
    text: "Prerna encourages Biblical learning through Bible quizzing.",
    url: "https://preranabiblequiz.com/"
  },
  "/events/arise/": {
    text: "Arise is a Christian gathering in Mumbai."
  }
};

const event = events[Astro.url.pathname];
const oldMira = Astro.url.pathname === "/congregations/mira-road/";
---

<BaseLayout title={page.title} description={description} noindex={true}>
  <section class="inner-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        {page.parentHref !== "/" && (
          <>
            <span aria-hidden="true">/</span>
            <a href={page.parentHref}>{page.parent}</a>
          </>
        )}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{page.title}</span>
      </nav>

      <div class="intro">
        <span class="eyebrow">Mumbai Church of Christ</span>
        <h1>{page.title}</h1>
        <p class="lead">{event?.text || description}</p>

        {event?.url && (
          <Button href={event.url}>Official Event Website</Button>
        )}
      </div>
    </div>
  </section>

  <section class="section section-paper">
    <div class="container">
      {page.links.length > 0 ? (
        <div class="grid-3">
          {page.links.map((link: { label: string; href: string }) => (
            <a class="directory-card" href={link.href}>
              <h3>{link.label}</h3>
              <span>Explore →</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="section-heading">
          <span class="eyebrow">Under development</span>
          <h2>More information coming soon.</h2>
          <p class="lead">{oldMira ? "The earlier Mira Road listing is being checked. Browse the directory for the Poonam Sagar profile and other congregations." : "We are preparing this section of our new website."}</p>{oldMira && <p><a class="button button-primary" href="/congregations/?q=Mira%20Road">Explore Mira Road listings →</a></p>}
          <Button href={page.parentHref} variant="outline">
            Back to {page.parent}
          </Button>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .inner-hero {
    padding-block: 32px 85px;
    border-bottom: 1px solid var(--sand);
    background: radial-gradient(ellipse at top right,rgba(180,154,102,.12),transparent 65%),var(--ivory);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 15px;
    color: var(--muted);
  }

  .breadcrumbs a:hover {
    text-decoration: underline;
  }

  .intro {
    max-width: 850px;
    margin-top: 64px;
  }

  .intro h1 {
    font-size: clamp(40px,6vw,76px);
    margin-block: 24px;
  }

  .directory-card {
    display: flex;
    flex-direction: column;
    min-height: 190px;
    padding: 30px;
    border: 1px solid var(--sand);
    background: var(--ivory);
    border-radius: 10px;
    transition: transform .3s, border-color .3s, box-shadow .3s;
  }

  .directory-card h3 {
    font-size: 27px;
  }

  .directory-card span {
    margin-top: auto;
    color: var(--forest);
    font-weight: 600;
  }

  @media (hover:hover) and (pointer:fine) {
    .directory-card:hover {
      transform: translateY(-4px);
      border-color: var(--gold);
      box-shadow: var(--shadow-soft);
    }
  }
</style>
