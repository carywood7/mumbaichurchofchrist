---
import CongregationLayout from "../../layouts/CongregationLayout.astro";
import { areas } from "../../data/congregations";
export function getStaticPaths() {
  return areas.map(area => ({ params: { congregation: area.slug }, props: { area } }));
}
const { area } = Astro.props;
---
<CongregationLayout area={area}/>
