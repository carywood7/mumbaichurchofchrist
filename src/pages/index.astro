<script>
  // Scripture rotator with pause and reduced-motion support.

  const rotator = document.querySelector<HTMLElement>("[data-verse-rotator]");

  if (rotator) {
    const slides = Array.from(rotator.querySelectorAll<HTMLElement>("[data-verse]"));
    const dots = Array.from(rotator.querySelectorAll<HTMLButtonElement>("[data-verse-index]"));
    const pause = rotator.querySelector<HTMLButtonElement>("[data-pause-verse]");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");

    let index = 0;
    let paused = reduced.matches;
    let timer: number | undefined;

    function show(next: number) {
      index = (next + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        slide.hidden = i !== index;
      });

      dots.forEach((dot, i) => {
        dot.setAttribute("aria-pressed", String(i === index));
      });
    }

    function restart() {
      window.clearInterval(timer);

      if (!paused && !document.hidden && !rotator?.matches(":hover") &&
          !rotator?.contains(document.activeElement)) {
        timer = window.setInterval(() => show(index + 1), 8000);
      }
    }

    function updatePause() {
      if (!pause) return;

      pause.textContent = paused ? "▶" : "Ⅱ";
      pause.setAttribute("aria-label",
        paused ? "Resume automatic rotation" : "Pause automatic rotation");
    }

    rotator.querySelector("[data-prev-verse]")?.addEventListener("click", () => {
      show(index - 1);
      restart();
    });

    rotator.querySelector("[data-next-verse]")?.addEventListener("click", () => {
      show(index + 1);
      restart();
    });

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        show(i);
        restart();
      });
    });

    pause?.addEventListener("click", () => {
      paused = !paused;
      updatePause();
      restart();
    });

    rotator.addEventListener("pointerenter", restart);
    rotator.addEventListener("pointerleave", restart);
    rotator.addEventListener("focusin", restart);
    rotator.addEventListener("focusout", () => requestAnimationFrame(restart));
    document.addEventListener("visibilitychange", restart);

    reduced.addEventListener("change", () => {
      if (reduced.matches) paused = true;
      updatePause();
      restart();
    });

    updatePause();
    restart();
  }

  // Congregation region filtering.

  const explorer = document.querySelector("[data-congregation-explorer]");

  if (explorer) {
    const buttons = Array.from(explorer.querySelectorAll<HTMLButtonElement>("[data-region-filter]"));
    const cards = Array.from(explorer.querySelectorAll<HTMLElement>("[data-region]"));

    buttons.forEach(button => {
      button.addEventListener("click", () => {
        const region = button.dataset.regionFilter;
        let count = 0;

        buttons.forEach(other => {
          other.setAttribute("aria-pressed", String(other === button));
        });

        cards.forEach(card => {
          card.hidden = region !== "all" && card.dataset.region !== region;
          if (!card.hidden) count++;
        });

        const status = explorer.querySelector("[data-filter-status]");

        if (status) status.textContent = `${count} congregations displayed`;
      });
    });
  }

  // Hover FAQ on desktop; native details on mobile.

  const hover = matchMedia("(hover:hover) and (pointer:fine)");
  const faqs = Array.from(document.querySelectorAll<HTMLDetailsElement>(".faq-item"));

  faqs.forEach(faq => {
    let hoverOpened = false;

    faq.addEventListener("pointerenter", () => {
      if (!hover.matches || faq.open) return;

      faqs.forEach(other => {
        if (other !== faq && !other.contains(document.activeElement)) {
          other.open = false;
        }
      });

      hoverOpened = true;
      faq.open = true;
    });

    faq.addEventListener("pointerleave", () => {
      if (hoverOpened && !faq.contains(document.activeElement)) {
        faq.open = false;
        hoverOpened = false;
      }
    });

    faq.addEventListener("focusout", event => {
      if (hoverOpened && !faq.matches(":hover") &&
          !faq.contains(event.relatedTarget as Node | null)) {
        faq.open = false;
        hoverOpened = false;
      }
    });

    faq.querySelector("summary")?.addEventListener("click", event => {
      if (hover.matches && hoverOpened && event.detail > 0) {
        event.preventDefault();
        hoverOpened = false;
      }
    });

    faq.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        faq.open = false;
        hoverOpened = false;
        faq.querySelector("summary")?.focus();
      }
    });
  });
</script>
