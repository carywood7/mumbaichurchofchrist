---
import BaseLayout from "./BaseLayout.astro";
import type { Area } from "../data/congregations";
import { localDiscovery } from "../data/local-discovery";
const { area } = Astro.props as { area: Area };
const local = localDiscovery[area.slug as keyof typeof localDiscovery];
if (!local) throw new Error(`Missing area copy: ${area.slug}`);
const contact = `/contact/#area=${encodeURIComponent(area.slug)}`;
const regionLink = `/congregations/${local.regionSlug}/`;
const faqs = [
  { question: `How can I enquire about the Church of Christ in ${area.name}?`, answer: `Use our central contact page and select ${area.name} as your preferred area. Participation and enquiries are entirely voluntary.` },
  { question: local.question, answer: local.answer },
  { question: "What does the Church of Christ believe?", answer: "Churches of Christ seek to follow Jesus Christ and the teachings of the New Testament. Explore the beliefs page for a Scripture-based explanation." },
  { question: "Can I explore the Bible on this website?", answer: "Yes. Our written Bible studies, sermons and Biblical questions are freely available to read at your own pace." }
];
---
<BaseLayout title={`Church in ${local.title} – Church of Christ`} description={`Looking for a Church of Christ in ${local.title}? Explore Christian worship, Biblical beliefs, Bible study resources and general enquiries.`} noindex={true}>
  <section class="area-hero">
    <div class="container">
      <nav class="area-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/congregations/">Congregations</a> / <span>{area.name}</span></nav>
      <span class="eyebrow">{local.region} · Church of Christ</span>
      <h1>Looking for a church in {area.name}?</h1>
      <p class="area-lead">Learn about the Church of Christ in {area.name}, Christian worship and Biblical resources.</p>
      <div class="area-actions"><a class="button button-primary" href={contact}>Contact Us →</a><a class="area-secondary" href="#area-overview">Explore our faith ↓</a></div>
    </div>
  </section>
  <section class="section section-paper" id="area-overview">
    <div class="container area-overview">
      <div><span class="eyebrow">Local church discovery</span><h2>Church of Christ in {area.name}.</h2><p class="lead">{local.intro}</p><a class="area-text-link" href={regionLink}>Explore the regional directory →</a></div>
      <aside class="area-aside"><span class="eyebrow">Rooted in Scripture</span><blockquote>“The churches of Christ salute you.”<cite>Romans 16:16 · KJV</cite></blockquote></aside>
    </div>
  </section>
  <section class="section area-topics"><div class="container"><span class="eyebrow">Discover our faith</span><h2>Christian worship and Bible study.</h2><div class="area-grid">
    <a href="/about/what-we-believe/"><span>01 · Beliefs</span><h3>What we believe</h3><p>Explore the authority of Scripture and faith in Jesus Christ.</p><b>Read more →</b></a>
    <a href="/plan-your-visit/"><span>02 · Worship</span><h3>Christian worship</h3><p>Learn about singing, prayer, teaching and the Lord’s Supper.</p><b>Visitor information →</b></a>
    <a href="/request-a-bible-study/"><span>03 · Scripture</span><h3>Bible study</h3><p>Explore written studies and information about Bible study enquiries.</p><b>Explore Bible study →</b></a>
  </div><a class="area-text-link" href={`/${local.resource}/`}>Suggested reading for this area →</a></div></section>
  <section class="section section-paper"><div class="container area-overview"><div><span class="eyebrow">Helpful answers</span><h2>Questions are welcome.</h2><p>Explore our Biblical resources or get in touch with a general enquiry.</p></div><div class="area-faq" data-area-faq>{faqs.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></div></section>
  <section class="area-closing"><div class="container"><h2>Have a question about {area.name}?</h2><p>We welcome voluntary enquiries about Christian worship and Biblical resources.</p><a class="button button-primary" href={contact}>Contact Us →</a></div></section>
</BaseLayout>
<script>
const hover = matchMedia('(hover:hover) and (pointer:fine)');
document.querySelectorAll<HTMLDetailsElement>('[data-area-faq] details').forEach(item=>{
 let transient=false;
 item.addEventListener('pointerenter', e=>{if(hover.matches && e.pointerType==='mouse' && !item.open){item.open=true;transient=true;}});
 const close=()=>{if(transient && !item.matches(':hover') && !item.contains(document.activeElement)){item.open=false;transient=false;}};
 item.addEventListener('pointerleave',close);
 item.addEventListener('focusout',()=>requestAnimationFrame(close));
 item.querySelector('summary')?.addEventListener('click',e=>{if(transient && e.detail>0){e.preventDefault();transient=false;}});
});
</script>
<style>
.area-hero{background:radial-gradient(ellipse at 90% 10%,#36577b,#112239 68%);color:white;padding:clamp(45px,8vw,110px) 0}.area-breadcrumb{color:#d2dce8;font-size:14px;margin-bottom:35px}.area-hero .eyebrow{color:#d6bf91}.area-hero h1{color:white;max-width:950px;margin:20px 0;font-size:clamp(42px,5.6vw,78px)}.area-lead{color:#e1e7ef;max-width:700px;font-size:clamp(18px,2vw,23px);line-height:1.7}.area-actions{display:flex;flex-wrap:wrap;align-items:center;gap:22px;margin-top:30px}.area-hero .button,.area-closing .button{background:#fffdf8;color:#182d49}.area-secondary{color:#fff;text-decoration:underline;text-underline-offset:5px}.area-overview{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(30px,5vw,80px);align-items:start}.area-overview h2,.area-topics h2{margin:16px 0 20px}.area-overview p{color:#5d6370;line-height:1.8}.area-aside{padding:30px;border:1px solid #ddd4c4;border-radius:12px;background:#faf7f0}.area-aside blockquote{font-family:var(--font-heading);font-size:clamp(24px,3vw,35px);color:#182d49;margin:15px 0 0;line-height:1.4}.area-aside cite{display:block;font:14px var(--font-body);color:#80683e;margin-top:15px}.area-text-link{display:inline-block;color:#36577b;font-weight:600;margin-top:22px;text-decoration:underline;text-underline-offset:4px}.area-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:26px 0}.area-grid a{display:flex;flex-direction:column;padding:28px;gap:12px;border:1px solid #ddd4c4;border-radius:12px;background:#fffdf8;transition:transform .2s,box-shadow .2s}.area-grid span{color:#80683e;font-size:13px;font-weight:600}.area-grid h3{margin:0;font-size:27px;color:#182d49}.area-grid p{color:#5d6370;line-height:1.65;margin:0}.area-grid b{margin-top:auto;color:#36577b}.area-faq details{border-bottom:1px solid #ddd4c4;padding:17px 0}.area-faq summary{display:flex;justify-content:space-between;gap:16px;cursor:pointer;font-weight:600;color:#182d49;list-style:none}.area-faq summary::-webkit-details-marker{display:none}.area-faq summary span{color:#80683e}.area-faq details[open] summary span{transform:rotate(45deg)}.area-faq p{margin:12px 0 0}.area-closing{background:#182d49;color:white;padding:clamp(48px,7vw,88px) 0;text-align:center}.area-closing h2{color:white;margin:0 0 18px}.area-closing p{color:#d2dce8;margin-bottom:25px}@media(hover:hover) and (pointer:fine){.area-grid a:hover{transform:translateY(-4px);box-shadow:0 12px 30px #182d4914}}@media(max-width:850px){.area-overview{grid-template-columns:1fr}.area-grid{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){.area-grid a{transition:none}}
</style>
