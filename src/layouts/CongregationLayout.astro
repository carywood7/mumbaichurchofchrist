---
import BaseLayout from "./BaseLayout.astro";
import Hero from "../components/congregation/Hero.astro";
import Journeys from "../components/congregation/Journeys.astro";
import LocalLife from "../components/congregation/LocalLife.astro";
import VisitConnect from "../components/congregation/VisitConnect.astro";
import type { Congregation } from "../data/congregations";
import {
  localTitle,
  localDescription,
  publicChurchEntity
} from "../data/local-seo";
import "../styles/congregation.css";
const { c } = Astro.props as { c: Congregation };

const searchReady =
  c.approved &&
  !c.detailsStatus &&
  Boolean(c.address.trim()) &&
  c.gatherings.some(g =>
    g.kind === "worship" && Boolean(g.time)
  ) &&
  Boolean(c.email || c.contacts.length);

---
<BaseLayout title={localTitle(c)} description={localDescription(c)} noindex={!searchReady}
  socialImage={c.photos[0] || undefined}
  primaryEntity={searchReady ? publicChurchEntity(c) : undefined}
>
  <div class="cf-page" data-congregation-funnel>
    {!c.approved && <div class="cf-preview">Local preview · Contact information, meeting details and map pin require publication approval.</div>}
    <Hero c={c}/>
    <nav class="cf-local-nav" aria-label="Congregation sections"><div class="container"><a href="#discover-jesus">Discover Jesus</a><a href="#salvation">Salvation</a><a href="#our-faith">Our faith</a><a href="#worship">Worship</a><a href="#bible-study">Bible study</a><a href="#preacher">Preacher</a>{c.photos.length > 0 && <a href="#gallery">Our congregation</a>}<a href="#visit">Visit us</a><a href="#connect">Contact</a></div></nav>
    <Journeys/>
    <LocalLife c={c}/>
    <VisitConnect c={c}/>
  </div>
</BaseLayout>
<script>
  const page = document.querySelector<HTMLElement>('[data-congregation-funnel]');
  if (page) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const hover = matchMedia('(hover:hover) and (pointer:fine)');
    page.querySelectorAll<HTMLElement>('[data-switcher]').forEach(group => {
      const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-select]'));
      const panels = Array.from(group.querySelectorAll<HTMLElement>('[data-panel]'));
      const prev = group.querySelector<HTMLButtonElement>('[data-prev]');
      const next = group.querySelector<HTMLButtonElement>('[data-next]');
      let selected = 0;
      function select(i: number) {
        selected = Math.max(0, Math.min(buttons.length-1,i));
        buttons.forEach((b,j)=>b.setAttribute('aria-pressed',String(j===selected)));
        panels.forEach((p,j)=>p.hidden=j!==selected);
        if(prev) prev.disabled=selected===0;
        if(next) next.disabled=selected===buttons.length-1;
        const count=group.querySelector('[data-step-count]'); if(count) count.textContent=`${selected+1} / ${buttons.length}`;
      }
      buttons.forEach((button, i) => {
        button.addEventListener('click', () => select(i));

        button.addEventListener('pointerenter', event => {
          if (hover.matches && event.pointerType === 'mouse') {
            select(i);
          }
        });
      });
      prev?.addEventListener('click',()=>select(selected-1)); next?.addEventListener('click',()=>select(selected+1));
    });
    const verses=Array.from(page.querySelectorAll<HTMLElement>('[data-verse]'));
    const dots=Array.from(page.querySelectorAll<HTMLButtonElement>('[data-verse-select]'));
    const pause=page.querySelector<HTMLButtonElement>('[data-verse-pause]');
    const verseBox=page.querySelector<HTMLElement>('[data-verse-box]');
    let index=0, paused=reduced.matches, hovered=false;
    function show(i:number){ index=i; verses.forEach((v,j)=>v.hidden=j!==i); dots.forEach((v,j)=>v.setAttribute('aria-pressed',String(j===i))); }
    function setPaused(v:boolean){ paused=v; if(pause){pause.textContent=v?'Play':'Pause';pause.setAttribute('aria-pressed',String(v));} }
    setPaused(paused);
    dots.forEach((dot,i)=>dot.addEventListener('click',()=>{show(i);setPaused(true);}));
    pause?.addEventListener('click',()=>setPaused(!paused));
    verseBox?.addEventListener('pointerenter',()=>hovered=true); verseBox?.addEventListener('pointerleave',()=>hovered=false);
    reduced.addEventListener('change',()=>{if(reduced.matches)setPaused(true);});
    if(verses.length>1) window.setInterval(()=>{if(!paused&&!hovered&&!document.hidden&&!verseBox?.contains(document.activeElement))show((index+1)%verses.length);},7000);
    page.querySelectorAll<HTMLDetailsElement>('.cf-accordion details').forEach(d=>{
      let transient=false;
      d.addEventListener('pointerenter',()=>{if(hover.matches&&!d.open){d.open=true;transient=true;}});
      const close=()=>{if(transient&&!d.matches(':hover')&&!d.contains(document.activeElement)){d.open=false;transient=false;}};
      d.addEventListener('pointerleave',close); d.addEventListener('focusout',()=>requestAnimationFrame(close));
      d.querySelector('summary')?.addEventListener('click',e=>{if(transient&&e.detail>0){e.preventDefault();transient=false;}});
    });
    page.querySelector<HTMLButtonElement>('[data-copy-address]')?.addEventListener('click',async e=>{
      const button=e.currentTarget as HTMLButtonElement; const status=page.querySelector('[data-copy-status]');
      try {await navigator.clipboard.writeText(button.dataset.copyAddress||'');if(status)status.textContent='Address copied.';}catch{if(status)status.textContent='Please select and copy the address above.';}
    });
  }
</script>
