---
import BaseLayout from "./BaseLayout.astro";
import type { Area } from "../data/congregations";
const { area } = Astro.props as { area: Area };
---
<BaseLayout title={`Church of Christ in ${area.name}`} description={`General information about Churches of Christ in ${area.name} and the Mumbai region. Explore Biblical resources and central enquiries.`} noindex={true}>
  <section class="inner-hero area-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/congregations/">Congregations</a> / <span>{area.name}</span></nav>
      <span class="eyebrow">{area.region}</span>
      <h1>Church of Christ in {area.name}.</h1>
      <p class="lead">Rooted in Scripture. United in Christ.</p>
      <p>For questions about Christian worship or Churches of Christ in this area, please contact us.</p>
      <a class="button button-primary" href="/contact/">Contact us →</a>
    </div>
  </section>
  <section class="section section-paper">
    <div class="container">
      <span class="eyebrow">Discover our faith</span>
      <h2>Explore Scripture and Christian worship.</h2>
      <p class="lead">Churches of Christ seek to follow the teachings of Jesus and the New Testament. Learn about our beliefs and the Biblical foundations of worship.</p>
      <div class="area-links">
        <a href="/about/what-we-believe/">What we believe →</a>
        <a href="/plan-your-visit/">About Christian worship →</a>
        <a href="/resources/bible-studies/">Bible study resources →</a>
        <a href="/congregations/">Explore other areas →</a>
      </div>
      <blockquote>“The churches of Christ salute you.” <cite>Romans 16:16 · KJV</cite></blockquote>
    </div>
  </section>
</BaseLayout>
<style>
.area-hero {background:linear-gradient(115deg,#112239,#36577b);color:#fff;padding:clamp(50px,8vw,110px) 0}
.area-hero h1{color:white;max-width:880px}.area-hero .eyebrow{color:#d6bf91}.area-hero p{color:#e1e7ef;max-width:680px;line-height:1.8}.area-hero .breadcrumbs{margin-bottom:30px;color:#e1e7ef}.area-hero .button{margin-top:20px;background:#fffdf8;color:#182d49}.area-links{display:flex;flex-wrap:wrap;gap:15px;margin:28px 0}.area-links a{border:1px solid #ddd4c4;border-radius:6px;padding:14px 20px;color:#182d49;font-weight:600}.area-links a:hover{border-color:#b49a66;background:#faf7f0}blockquote{border-left:3px solid #b49a66;padding:20px;color:#182d49}cite{display:block;margin-top:8px;font-size:14px}
</style>
