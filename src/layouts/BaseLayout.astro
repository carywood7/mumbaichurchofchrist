---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { seoGraph, type Entity } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  primaryEntity?: Entity;
  socialImage?: string;
}

const {
  title = "Mumbai Church of Christ",
  description = "Explore general information about Churches of Christ across Mumbai and Navi Mumbai and discover Biblical resources.",
  noindex = true,
  primaryEntity,
  socialImage
} = Astro.props;

const productionRelease =
  import.meta.env.PROD && process.env.CI === "true";

const allowIndex = productionRelease && !noindex;

const siteName = "Mumbai Church of Christ";

const pageTitle = title === siteName
  ? title
  : `${title} | ${siteName}`;

const canonical = new URL(
  Astro.url.pathname,
  "https://mumbaichurchofchrist.com"
);

const structuredData = seoGraph(
  canonical, title, description,
  primaryEntity, socialImage
);
const imageUrl = socialImage
  ? new URL(socialImage, canonical.origin).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#182D49" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={allowIndex
      ? "index, follow"
      : productionRelease
        ? "noindex, follow"
        : "noindex, nofollow"} />

    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content={
      primaryEntity?.["@type"] === "Article" ? "article" : "website"
    } />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    {allowIndex && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
      ></script>
    )}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />

    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
